# Copy to backend/.env for local development, or set these as environment
# variables in Render's dashboard for deployment. Never commit the real
# values — this file is just a template.

# Password for /admin — required. Pick something you wouldn't mind a
# reasonably determined stranger guessing, since there's currently no
# rate-limiting or lockout on login attempts.
ADMIN_PASSWORD=change-me-before-deploying

# Only needed if you've attached a Render persistent disk (see render.yaml).
# Leave unset for local development.
# DATA_DIR=/data
